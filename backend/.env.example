# Blockchain Attribution Engine - Backend Environment Variables

# (Optional) Etherscan API Key - If provided, Etherscan API can be queried directly
ETHERSCAN_API_KEY=

# Blockchain Provider Endpoints (Defaults already work out-of-the-box)
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com/api/v2
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Server & Timeout Settings
API_TIMEOUT_SECONDS=20.0
MAX_TRANSACTIONS_FETCH=50
